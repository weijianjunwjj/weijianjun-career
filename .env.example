# Optional override for a separately confirmed permanent HTTPS site URL.
# The default is the user's confirmed production site:
# https://weijianjun.me/
# VITE_SITE_URL=https://your-confirmed-domain.example/path/

# 百度统计公开 ID（32 位十六进制，非密钥）。留空则不注入 hm.js，联系卡仍可在生产域展示。
# 子站 VITE_BAIDU_HM_ID_WORK 留空时回退 VITE_BAIDU_HM_ID_MAIN。
# 不要把真实 ID 提交进仓库；CI 使用 vars.VITE_BAIDU_HM_ID_MAIN / vars.VITE_BAIDU_HM_ID_WORK。
# VITE_BAIDU_HM_ID_MAIN=0123456789abcdef0123456789abcdef
# VITE_BAIDU_HM_ID_WORK=0123456789abcdef0123456789abcdef
