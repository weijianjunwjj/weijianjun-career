{
  "name": "weijianjun-career",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:work": "vite --config vite.work.config.mjs --host 127.0.0.1 --port 5174",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender.mjs",
    "build:work": "vue-tsc --noEmit && vite build --config vite.work.config.mjs",
    "build:all": "pnpm build && pnpm build:work",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:work": "vite preview --config vite.work.config.mjs --host 127.0.0.1 --port 4174",
    "check": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@sentry/vue": "^11.8.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^11.8.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
